APP_NAME=TuConpay
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Caracas
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_VE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Base de Datos (MySQL Laragon local) ───────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tuconpay
DB_USERNAME=root
DB_PASSWORD=

# ─── Cache & Sesiones ──────────────────────────────────────────────────────────
# Usar 'database' si Redis no está disponible en local. Cambiar a 'redis' en prod.
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ─── Colas ─────────────────────────────────────────────────────────────────────
QUEUE_CONNECTION=database

# ─── Redis (disponible en producción / opcional en local) ─────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Broadcasting / WebSockets (Reverb) ────────────────────────────────────────
BROADCAST_CONNECTION=log
REVERB_APP_ID=tuconpay-local
REVERB_APP_KEY=tuconpay-key-local
REVERB_APP_SECRET=tuconpay-secret-local
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_ALGO=HS256

# ─── Almacenamiento ────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local

# ─── Correo ────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@tuconpay.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── SLA ───────────────────────────────────────────────────────────────────────
TICKET_SLA_MINUTES=90
TICKET_SLA_ALERT_THRESHOLD_MINUTES=30
TICKET_CODE_PREFIX=TC

# ─── Distribución Financiera (%%) ──────────────────────────────────────────────
DIST_ATC_PERCENT=25
DIST_BROKER_PERCENT=10
DIST_PROVIDER_PERCENT=30
DIST_ADMIN_PERCENT=35

# ─── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Scribe (Documentación API) ────────────────────────────────────────────────
SCRIBE_AUTH_DEFAULT_VALUE="Bearer tu-token-aqui"

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
